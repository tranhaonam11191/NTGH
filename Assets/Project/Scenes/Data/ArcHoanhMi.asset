  Data:
  - content: "\u0110\u1ED1i ph\xF3 H\u1ED3ng H\u01B0ng ph\u1EA3i ra tay c\u1EA3 v\u1EDBi
      ngo\u1EA1i vi\u1EC7n, m\u1EE5c ti\xEAu c\u1EE7a ta l\xE0 G\xE0 R\u1EEBng, bang
      ch\u1EE7 \u0110\u1ED9c X\xE0 Bang \u0110\xE0i Loan "
    imgCharacter: {fileID: 21300000, guid: b84565c53669445c285e8e76fcb34b14, type: 3}
  - content: "\u0110\u1ED9c X\xE0 Bang c\u0169ng d\xE1m ch\u1ECDc v\xE0o, \u0111\u1EC3
      tao cho m\xE0y bi\u1EBFt bang ph\xE1i \u0110\xE0i Loan l\u1EDBn th\u1EBF n\xE0o"
    imgCharacter: {fileID: 21300000, guid: f76155c5d84f344c8a3df2db33b4a4f2, type: 3}
  - content: "G\xE0 R\u1EEBng, m\xE0y \u0111\u1EA5u v\u1EDBi L\xE3nh Di\u1EC7n H\u1ED5
      Ho\xE0nh Mi trong \u0110\xF4ng Anh Ng\u0169 H\u1ED5"
    imgCharacter: {fileID: 21300000, guid: 121610ad7febfb14095cfd9f04938b81, type: 3}
  - content: "C\xF3 t\u1EF1 tin kh\xF4ng?"
    imgCharacter: {fileID: 21300000, guid: 121610ad7febfb14095cfd9f04938b81, type: 3}
  - content: "Haha, kh\xF4ng c\u1EA7n ngh\u0129, win ch\u1EAFc"
    imgCharacter: {fileID: 21300000, guid: 1b5861e142102437ea8df7aff7fce5eb, type: 3}
  - content: "G\xE0 R\u1EEBng, 2 ch\xFAng ta quy\u1EBFt t\u1EED nh\u1EA5t chi\u1EBFn"
    imgCharacter: {fileID: 21300000, guid: b84565c53669445c285e8e76fcb34b14, type: 3}
  itemReward: {fileID: 11400000, guid: 78319ddf4d2704467b13d6d2defca849, type: 2}
